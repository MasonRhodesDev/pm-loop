{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Agent|Bash", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/lane-guard.py", "timeout": 10}]},
      {"matcher": ".*", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tool-cap.py", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"matcher": ".*", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/stall-check.py", "timeout": 10}]}
    ]
  }
}
